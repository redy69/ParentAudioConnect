<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient android:type="linear" android:angle="90"
                android:startColor="#58E9FFF7"
                android:centerColor="#39FFFFFF"
                android:endColor="#25D9F5EA" />
            <stroke android:width="1.3dp" android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:type="linear" android:angle="90"
                android:startColor="#48FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>