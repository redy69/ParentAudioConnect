<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:type="linear" android:angle="90"
                android:startColor="#38FFFFFF"
                android:centerColor="#24FFFFFF"
                android:endColor="#32FFFFFF"/>
            <stroke android:width="1.5dp" android:color="#DFFFFFFF"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient android:type="linear" android:angle="90"
                android:startColor="#45FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
            <stroke android:width="0.6dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>