rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParent() {
      return signedIn() && resource.data.parentUid == request.auth.uid;
    }

    function isChild() {
      return signedIn() && resource.data.childUid == request.auth.uid;
    }

    function isActiveUnclaimedPairing() {
      return signedIn()
        && resource.data.childUid == null
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
    }

    function validParentSettingsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'usageScheduleEnabled',
          'usageScheduleStartMinutes',
          'usageScheduleEndMinutes',
          'usageScheduleDays',
          'usageScheduleTimeZone',
          'usageScheduleUpdatedAt',
          'blockedApps',
          'appBlockUpdatedAt'
        ])
        && (!changed.hasAny(['usageScheduleEnabled'])
          || request.resource.data.usageScheduleEnabled is bool)
        && (!changed.hasAny(['usageScheduleStartMinutes'])
          || (request.resource.data.usageScheduleStartMinutes is int
            && request.resource.data.usageScheduleStartMinutes >= 0
            && request.resource.data.usageScheduleStartMinutes <= 1439))
        && (!changed.hasAny(['usageScheduleEndMinutes'])
          || (request.resource.data.usageScheduleEndMinutes is int
            && request.resource.data.usageScheduleEndMinutes >= 0
            && request.resource.data.usageScheduleEndMinutes <= 1439))
        && (!changed.hasAny(['usageScheduleDays'])
          || (request.resource.data.usageScheduleDays is list
            && request.resource.data.usageScheduleDays.size() >= 1
            && request.resource.data.usageScheduleDays.size() <= 7
            && request.resource.data.usageScheduleDays.hasOnly([1, 2, 3, 4, 5, 6, 7])))
        && (!changed.hasAny(['usageScheduleTimeZone'])
          || (request.resource.data.usageScheduleTimeZone is string
            && request.resource.data.usageScheduleTimeZone.size() <= 64))
        && (!changed.hasAny(['usageScheduleUpdatedAt'])
          || request.resource.data.usageScheduleUpdatedAt is timestamp)
        && (!changed.hasAny(['blockedApps'])
          || (resource.data.appBlockConsent == true
            && request.resource.data.blockedApps is list
            && request.resource.data.blockedApps.size() <= 100))
        && (!changed.hasAny(['appBlockUpdatedAt'])
          || request.resource.data.appBlockUpdatedAt is timestamp);
    }

    function validChildStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'deviceBatteryPercent',
          'deviceCharging',
          'deviceBatteryTempC',
          'deviceNetworkType',
          'deviceInternetValidated',
          'deviceOperatorName',
          'deviceStatusAt',
          'appUsageSummary',
          'appUsagePermissionGranted',
          'appUsageAt',
          'childScheduleQuietNow',
          'childScheduleCheckedAt',
          'childLatitude',
          'childLongitude',
          'childLocationAccuracyM',
          'childLocationAt',
          'childLocationSharingEnabled',
          'childLocationStoppedAt',
          'appPermissionAuditEnabled',
          'appPermissionAuditSummary',
          'appPermissionAuditAt',
          'appBlockConsent',
          'appBlockInstalledApps',
          'blockedApps',
          'appBlockUpdatedAt',
          'liveAudioActive',
          'mp3AudioActive',
          'audioActivityAt',
          'liveAudioActivityAt',
          'mp3AudioActivityAt'
        ])
        && (!changed.hasAny(['deviceBatteryPercent'])
          || (request.resource.data.deviceBatteryPercent is int
            && request.resource.data.deviceBatteryPercent >= -1
            && request.resource.data.deviceBatteryPercent <= 100))
        && (!changed.hasAny(['deviceCharging'])
          || request.resource.data.deviceCharging is bool)
        && (!changed.hasAny(['deviceBatteryTempC'])
          || request.resource.data.deviceBatteryTempC is number)
        && (!changed.hasAny(['deviceNetworkType'])
          || (request.resource.data.deviceNetworkType is string
            && request.resource.data.deviceNetworkType.size() <= 40))
        && (!changed.hasAny(['deviceInternetValidated'])
          || request.resource.data.deviceInternetValidated is bool)
        && (!changed.hasAny(['deviceOperatorName'])
          || (request.resource.data.deviceOperatorName is string
            && request.resource.data.deviceOperatorName.size() <= 80))
        && (!changed.hasAny(['deviceStatusAt'])
          || request.resource.data.deviceStatusAt is timestamp)
        && (!changed.hasAny(['appUsageSummary'])
          || (request.resource.data.appUsageSummary is list
            && request.resource.data.appUsageSummary.size() <= 12))
        && (!changed.hasAny(['appUsagePermissionGranted'])
          || request.resource.data.appUsagePermissionGranted is bool)
        && (!changed.hasAny(['appUsageAt'])
          || request.resource.data.appUsageAt is timestamp)
        && (!changed.hasAny(['childScheduleQuietNow'])
          || request.resource.data.childScheduleQuietNow is bool)
        && (!changed.hasAny(['childScheduleCheckedAt'])
          || request.resource.data.childScheduleCheckedAt is timestamp)
        && (!changed.hasAny(['childLatitude'])
          || (request.resource.data.childLatitude is number
            && request.resource.data.childLatitude >= -90
            && request.resource.data.childLatitude <= 90))
        && (!changed.hasAny(['childLongitude'])
          || (request.resource.data.childLongitude is number
            && request.resource.data.childLongitude >= -180
            && request.resource.data.childLongitude <= 180))
        && (!changed.hasAny(['childLocationAccuracyM'])
          || (request.resource.data.childLocationAccuracyM is number
            && request.resource.data.childLocationAccuracyM >= 0))
        && (!changed.hasAny(['childLocationAt'])
          || request.resource.data.childLocationAt is timestamp)
        && (!changed.hasAny(['childLocationSharingEnabled'])
          || request.resource.data.childLocationSharingEnabled is bool)
        && (!changed.hasAny(['childLocationStoppedAt'])
          || request.resource.data.childLocationStoppedAt is timestamp)
        && (!changed.hasAny(['appPermissionAuditEnabled'])
          || request.resource.data.appPermissionAuditEnabled is bool)
        && (!changed.hasAny(['appPermissionAuditSummary'])
          || (request.resource.data.appPermissionAuditSummary is list
            && request.resource.data.appPermissionAuditSummary.size() <= 30))
        && (!changed.hasAny(['appPermissionAuditAt'])
          || request.resource.data.appPermissionAuditAt is timestamp)
        && (!changed.hasAny(['appBlockConsent'])
          || request.resource.data.appBlockConsent is bool)
        && (!changed.hasAny(['appBlockInstalledApps'])
          || (request.resource.data.appBlockInstalledApps is list
            && request.resource.data.appBlockInstalledApps.size() <= 100))
        && (!changed.hasAny(['blockedApps'])
          || (request.resource.data.appBlockConsent == false
            && request.resource.data.blockedApps is list
            && request.resource.data.blockedApps.size() == 0))
        && (!changed.hasAny(['appBlockUpdatedAt'])
          || request.resource.data.appBlockUpdatedAt is timestamp)
        && (!changed.hasAny(['liveAudioActive'])
          || request.resource.data.liveAudioActive is bool)
        && (!changed.hasAny(['mp3AudioActive'])
          || request.resource.data.mp3AudioActive is bool)
        && (!changed.hasAny(['audioActivityAt'])
          || request.resource.data.audioActivityAt is timestamp)
        && (!changed.hasAny(['liveAudioActivityAt'])
          || request.resource.data.liveAudioActivityAt is timestamp)
        && (!changed.hasAny(['mp3AudioActivityAt'])
          || request.resource.data.mp3AudioActivityAt is timestamp);
    }

    match /pairings/{code} {
      allow create: if signedIn()
        && code.size() == 16
        && request.resource.data.keys().hasOnly([
          'parentUid', 'childUid', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'parentUid', 'childUid', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.childUid == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm');

      allow get: if isParent() || isChild() || isActiveUnclaimedPairing();
      allow list: if false;

      // One-time claim: the authenticated child may only set their own UID.
      allow update: if signedIn()
        && resource.data.parentUid != request.auth.uid
        && resource.data.childUid == null
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childUid']);

      // Parent-controlled settings: schedule and the selected blocked-app list.
      allow update: if isParent() && validParentSettingsUpdate();

      // Child-reported status, opt-ins and activity; no parent identity/settings fields.
      allow update: if isChild() && validChildStatusUpdate();

      allow delete: if isParent();
    }
  }
}
